+++ b/research/ffn/batched/arithmetic/candidates/arith_maps.hip
@@ -254,10 +254,21 @@ __global__ __launch_bounds__(NW * 32) void k_proj(
                 int8v aa[TT], ab[TT];
 #pragma unroll
                 for (int t = 0; t < TT; ++t) { aa[t] = int8v{}; ab[t] = int8v{}; }
+                // The two weight words of a slice are fetched one slice ahead. Loaded in the slice
+                // that uses them they issue behind that slice's fragment loads, and the expansion
+                // then waits on the whole outstanding queue instead of on two words. The last
+                // iteration re-reads slice 0, which is cached and never used.
+                const uint8_t *ap = abase + size_t(blk) * WB + col * 4;
+                const uint8_t *bp = bbase + size_t(blk) * WB + col * 4;
+                unsigned pa = *(const unsigned *) ap, pb = *(const unsigned *) bp;
 #pragma unroll 1
                 for (int s = 0; s < SLICES; ++s) {
-                    int4v wa = expand_i8(*(const unsigned *) (abase + size_t(blk) * WB + s * 64 + col * 4));
-                    int4v wb = expand_i8(*(const unsigned *) (bbase + size_t(blk) * WB + s * 64 + col * 4));
+                    const unsigned codes_a = pa, codes_b = pb;
+                    const int sn = (s + 1) & (SLICES - 1);
+                    pa = *(const unsigned *) (ap + sn * 64);
+                    pb = *(const unsigned *) (bp + sn * 64);
+                    int4v wa = expand_i8(codes_a);
+                    int4v wb = expand_i8(codes_b);
 #pragma unroll
                     for (int t = 0; t < TT; ++t) {
                         int4v bf = ((const int4v *) B)[size_t(blk * SLICES + s) * Npad + tg + t * 16 + col];
